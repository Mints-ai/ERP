rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper function to get the current employee's record
    function getEmployee() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }

    // Helper function to check if the user is a manager or above
    function isManagerOrAbove() {
      return getEmployee().role in ['founder', 'system_admin', 'c_suite', 'manager'];
    }

    // Helper: Founder or System Admin only (apex roles)
    function isFounderOrAdmin() {
      return getEmployee().role in ['founder', 'system_admin'];
    }

    // Helper function to check if the user is finance admin (Issue #9)
    function isFinanceAdmin() {
      return isAuth() && (
        getEmployee().role in ['founder', 'system_admin'] ||
        (getEmployee().role in ['c_suite', 'manager'] && (
          getEmployee().department == 'FINANCE' || 
          getEmployee().department == 'ACCOUNTING' ||
          (getEmployee().departments != null && ('FINANCE' in getEmployee().departments || 'ACCOUNTING' in getEmployee().departments))
        ))
      );
    }

    // Employees Collection Rules (Issue #1 & #18)
    // Restricts complete HR data reads to managers/admins or the employee themself
    match /employees/{employeeId} {
      allow read: if isAuth() && (request.auth.uid == employeeId || isManagerOrAbove());
      allow create: if isAuth() && isManagerOrAbove();

      // Self-service update: restricted to safe profile fields only (prevents role elevation)
      allow update: if isAuth() && request.auth.uid == employeeId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'fullName', 'phone', 'photoURL', 'profilePhotoURL', 'avatar', 'bio', 'preferences', 'notificationPrefs', 'lastSeenAt', 'updatedAt']);

      // Administrative update: all fields including role, isActive, department
      allow update: if isAuth() && isManagerOrAbove();
      allow delete: if isAuth() && isFounderOrAdmin();
    }

    // Sessions Collection Rules
    match /sessions/{sessionId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isManagerOrAbove());
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && (resource.data.uid == request.auth.uid || isManagerOrAbove());
      allow delete: if isAuth() && isManagerOrAbove();
    }

    // Leaves Collection Rules
    match /leaves/{leaveId} {
      allow read: if isAuth() && (resource.data.employeeId == request.auth.uid || isManagerOrAbove());
      allow create: if isAuth() && request.resource.data.employeeId == request.auth.uid;
      allow update: if isAuth() && isManagerOrAbove();
      allow delete: if isAuth() && isManagerOrAbove();
    }

    // Leave Balances Collection Rules (Issue #6)
    match /leaveBalances/{balanceId} {
      allow get: if isAuth() && (balanceId.matches('^' + request.auth.uid + '_.*') || (resource != null && resource.data.uid == request.auth.uid) || isManagerOrAbove());
      allow list: if isAuth() && isManagerOrAbove();
      allow write: if isAuth() && isManagerOrAbove();
    }

    // Tasks Collection Rules (SOC 2 CC6.1 / RBAC Least Privilege)
    match /tasks/{taskId} {
      allow read: if isAuth();
      // RBAC: Non-managers (interns, standard employees) can only create tasks assigned to themselves.
      // Delegation and assigning work across the organization requires manager role or above.
      // Designated team heads on team tasks can create subtasks.
      allow create: if isAuth() && (
        isManagerOrAbove() || 
        (request.resource.data.assignedTo == request.auth.uid && request.resource.data.assignedBy == request.auth.uid) ||
        (request.resource.data.parentTaskId != null && request.resource.data.teamHeads != null && request.auth.uid in request.resource.data.teamHeads)
      );
      // Updates: non-managers cannot tamper with or reassign assignedTo or assignedBy
      allow update: if isAuth() && (
        isManagerOrAbove() || 
        (resource.data.teamHeads != null && request.auth.uid in resource.data.teamHeads) ||
        ((resource.data.assignedTo == request.auth.uid || resource.data.assignedBy == request.auth.uid) && 
         request.resource.data.assignedTo == resource.data.assignedTo && 
         request.resource.data.assignedBy == resource.data.assignedBy)
      );
      allow delete: if isAuth() && isManagerOrAbove();

      match /remarks/{remarkId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isAuth() && (resource.data.createdBy == request.auth.uid || isManagerOrAbove());
      }
    }

    // Tickets Collection Rules (Issue #6)
    match /tickets/{ticketId} {
      allow get: if isAuth() && (resource.data.createdBy == request.auth.uid || resource.data.assignedTo == request.auth.uid || isManagerOrAbove());
      allow list: if isAuth() && (isManagerOrAbove() || resource.data.createdBy == request.auth.uid || resource.data.assignedTo == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.createdBy == request.auth.uid || resource.data.assignedTo == request.auth.uid || isManagerOrAbove());
      allow delete: if isAuth() && (resource.data.createdBy == request.auth.uid || isManagerOrAbove());

      match /comments/{commentId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.assignedTo == request.auth.uid ||
          isManagerOrAbove()
        );
        allow create: if isAuth();
        allow update, delete: if isAuth() && (resource.data.createdBy == request.auth.uid || isManagerOrAbove());
      }
    }

    // Clients Collection Rules
    match /clients/{clientId} {
      allow read: if isAuth();
      allow write: if isAuth() && isManagerOrAbove();
    }

    // Invoices Collection Rules
    match /invoices/{invoiceId} {
      allow read: if isAuth() && isFinanceAdmin();
      allow write: if isAuth() && isFinanceAdmin();
    }

    // Expenses Collection Rules
    match /expenses/{expenseId} {
      allow read: if isAuth() && (resource.data.submittedBy == request.auth.uid || isManagerOrAbove());
      allow create: if isAuth() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAuth() && isManagerOrAbove();
      allow delete: if isAuth() && isManagerOrAbove();
    }

    // Attendance Collection Rules
    match /attendance/{attendanceId} {
      allow read: if isAuth() && (resource == null || resource.data.uid == request.auth.uid || isManagerOrAbove());
      allow write: if isAuth() && (request.resource.data.uid == request.auth.uid || isManagerOrAbove());
    }

    // Attendance Corrections Collection Rules
    match /attendanceCorrections/{requestId} {
      allow get: if isAuth() && (resource.data.uid == request.auth.uid || isManagerOrAbove());
      allow list: if isAuth() && isManagerOrAbove();
      allow list: if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && isManagerOrAbove();
    }

    // Status Reports Collection Rules
    match /statusReports/{reportId} {
      allow get: if isAuth() && (resource.data.uid == request.auth.uid || isManagerOrAbove());
      allow list: if isAuth() && isManagerOrAbove();
      allow list: if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && isManagerOrAbove();
    }

    // Shoutouts Collection Rules
    match /shoutouts/{shoutoutId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuth() && (resource.data.authorId == request.auth.uid || isManagerOrAbove());
    }

    // Projects Collection Rules
    match /projects/{projectId} {
      allow read: if isAuth();
      allow write: if isAuth() && isManagerOrAbove();
    }

    // Settings Collection Rules
    // Sensitive webhook secrets and credentials require apex permissions
    match /settings/discordWebhook {
      allow read, write: if isAuth() && isFounderOrAdmin();
    }
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAuth() && isFounderOrAdmin();
    }

    // CRM Leads Collection Rules (Issue #6)
    match /leads/{leadId} {
      allow read, create, update, delete: if isAuth() && isManagerOrAbove();

      match /emails/{emailId} {
        allow read, write: if isAuth() && isManagerOrAbove();
      }
    }

    // Audit Log Collection Rules
    // SECURITY: auditLog is append-only. Tampering (update/delete) is permanently denied.
    // Only Founders and System Admins may read sensitive security events.
    match /auditLog/{logId} {
      allow read:   if isAuth() && isFounderOrAdmin();
      allow create: if isAuth();
      allow update: if false; // Tamper-proof: audit records are immutable
      allow delete: if false; // Tamper-proof: audit records cannot be purged
    }

    // PDF Vault Collection Rules (stores metadata for uploaded documents)
    match /pdfVaults/{vaultId} {
      allow read:   if isAuth() && isFinanceAdmin();
      allow create: if isAuth() && isManagerOrAbove();
      allow update: if false;
      allow delete: if isAuth() && isFounderOrAdmin();
    }

    // Security Events Collection Rules (blocked logins, de-duplication events)
    match /securityEvents/{eventId} {
      allow read:   if isAuth() && isFounderOrAdmin();
      allow create: if isAuth(); // Written by server-side auth hooks
      allow update: if false;
      allow delete: if false;
    }

    // Internal Mails Collection Rules (Issue #10)
    match /internal_mails/{mailId} {
      allow read: if isAuth() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        (resource.data.receiverId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'starred', 'deletedByReceiver', 'archived', 'folder', 'updatedAt']))
      );
      allow delete: if isAuth() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // Chat Channels Collection Rules (Issue #5)
    match /chatChannels/{channelId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        isManagerOrAbove() || 
        (resource.data.members != null && request.auth.uid in resource.data.members)
      );
      allow delete: if isAuth() && (
        isFounderOrAdmin() ||
        (resource.data.type == 'direct' && resource.data.members != null && request.auth.uid in resource.data.members)
      );
    }

    // Chat Messages Collection Rules
    match /messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && (resource.data.userId == request.auth.uid || isManagerOrAbove());
    }

    // Announcements Collection Rules
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow write: if isAuth() && isManagerOrAbove();
    }

    // OKRs Collection Rules
    match /okrs/{okrId} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        isManagerOrAbove() ||
        (resource != null && resource.data.ownerUid == request.auth.uid) ||
        (request.resource != null && request.resource.data.ownerUid == request.auth.uid)
      );
    }

    // Recruitment (Jobs & Candidates) Collection Rules
    match /jobs/{jobId} {
      allow read: if isAuth();
      allow write: if isAuth() && isManagerOrAbove();
    }
    match /candidates/{candidateId} {
      allow read: if isAuth();
      allow write: if isAuth() && isManagerOrAbove();
    }

    // Payroll Runs Rules
    match /payroll_runs/{runId} {
      allow read: if isAuth() && isManagerOrAbove();
      allow write: if isAuth() && isManagerOrAbove();
    }

     // Assets Collection Rules
    match /assets/{assetId} {
      allow read: if isAuth();
      allow write: if isAuth() && isManagerOrAbove();
    }

    // Asset Maintenance Logs Collection Rules
    match /assetMaintenanceLogs/{logId} {
      allow read: if isAuth();
      allow write: if isAuth() && isManagerOrAbove();
    }

    // Notifications Collection Rules (Issue #4)
    match /notifications/{notificationId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || resource.data.userId == 'global' || isManagerOrAbove());
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.userId == request.auth.uid || isManagerOrAbove());
    }

    // Chat Typing Presence Collection Rules
    match /chatTyping/{typingId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Login Activity Collection Rules (Issue #8)
    match /loginActivity/{activityId} {
      allow read: if isAuth() && isFounderOrAdmin();
      allow create: if isAuth() || (
        request.resource.data.status == "failed" &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 100 &&
        request.resource.data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$') &&
        request.resource.data.uid is string &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'fullName', 'role', 'ip', 'browser', 'device', 'platform', 'sessionType', 'status', 'createdAt', 'loginAt'])
      );
      allow update, delete: if false;
    }

    // Employee Documents Collection Rules (HR Document Expiry Tracker)
    match /employeeDocuments/{docId} {
      allow read, write: if isAuth() && isManagerOrAbove();
    }

    // Role Delegations Collection Rules
    match /delegations/{delegationId} {
      allow read: if isAuth() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid || isManagerOrAbove());
      allow write: if isAuth() && isManagerOrAbove();
    }

    // Client Errors & Telemetry Logging Rules
    match /client_errors/{errorId} {
      allow read: if isAuth() && isFounderOrAdmin();
      allow create: if isAuth();
      allow update, delete: if isAuth() && isFounderOrAdmin();
    }

    // Workflows Collection Rules
    match /workflows/{workflowId} {
      allow read: if isAuth();
      allow write: if isAuth() && isManagerOrAbove();
    }

    // Reactivation Requests Collection Rules (Issue #3)
    match /reactivation_requests/{requestId} {
      allow read: if isAuth() && isManagerOrAbove();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'reason', 'requestedAt', 'status'])
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500;
      allow update, delete: if isAuth() && isManagerOrAbove();
    }
  }
}

