rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper to check authentication
    function isAuth() {
      return request.auth != null;
    }

    function isManagerOrAbove() {
      return isAuth() && firestore.get(/databases/(default)/documents/employees/$(request.auth.uid)).data.role in ['founder', 'system_admin', 'c_suite', 'manager'];
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isValidDocumentType() {
      return request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)');
    }
    
    function isValidAttachmentType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)|application/pdf|application/(msword|vnd\\.openxmlformats-officedocument\\..*|vnd\\.ms-excel|vnd\\.ms-powerpoint)|text/(plain|csv)|application/(zip|x-zip-compressed)');
    }
    
    // Profile Photos: Anyone logged in can read. Only the user can upload their own with image validation.
    match /profile-photos/{userId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId 
                   && request.resource.size < 5 * 1024 * 1024
                   && isValidImageType();
    }

    // Resumes: Only recruiters/managers/HR can read and write candidate resumes
    match /resumes/{allPaths=**} {
      allow read: if isAuth() && isManagerOrAbove();
      allow write: if isAuth() && isManagerOrAbove()
                   && request.resource.size < 10 * 1024 * 1024
                   && isValidDocumentType();
    }

    // Task Attachments: Max 10MB, strict whitelisted safe mime types (Issue #7 & #11)
    match /task_attachments/{taskId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth() 
                   && request.resource.size < 10 * 1024 * 1024
                   && isValidAttachmentType(); 
    }

    // Default fallback: Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
